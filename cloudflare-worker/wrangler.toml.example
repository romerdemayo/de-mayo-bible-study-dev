name = "de-mayo-facebook-publisher"
main = "src/index.js"
compatibility_date = "2026-07-31"

# 7:00 PM UTC = 7:00 AM New Zealand Standard Time.
# During NZ daylight saving, change this to 18:00 UTC for 7:00 AM NZDT.
[triggers]
crons = ["0 19 * * *"]

[vars]
ALLOWED_ORIGIN = "https://romerdemayo.github.io"
GRAPH_API_VERSION = "v23.0"
AUTO_CONTENT = "mixed"

# Add secrets with Wrangler; never place them in this file:
# npx wrangler secret put FB_PAGE_ID
# npx wrangler secret put FB_PAGE_ACCESS_TOKEN
# npx wrangler secret put APP_SHARED_SECRET
